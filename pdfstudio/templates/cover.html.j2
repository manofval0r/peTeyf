<section class="cover-page" aria-label="Cover">
<div class="cover cover--{{ cover_style }}">
  {% if cover_style == 'image' and cover_image_uri %}
  <div class="cover__media"><img src="{{ cover_image_uri }}" alt="{{ title }}" style="object-fit:cover;object-position:{{ cover_focal }}" /></div>
  <div class="cover__scrim"></div>
  {% elif cover_style == 'split' and cover_image_uri %}
  <div class="cover__media">
    <img src="{{ cover_image_uri }}" alt="{{ title }}" style="object-fit:cover;object-position:{{ cover_focal }}" />
    <div class="cover__media-overlay"></div>
  </div>
  {% elif cover_style == 'object' and cover_image_uri %}
  <div class="cover__object"><img src="{{ cover_image_uri }}" alt="{{ title }}" style="object-fit:contain;object-position:{{ cover_focal }}" /></div>
  {% endif %}

  <div class="cover__content">
    {% if brand_mark or org %}
    <div class="cover__header">
      {% if brand_mark %}
      <div class="cover__brand">{{ brand_mark|safe }}</div>
      {% elif org %}
      <div class="cover__brand">
        <span class="cover__brand-pip"></span>
        <span class="cover__brand-text">{{ org }}</span>
      </div>
      {% endif %}
      {% if confidential %}<div class="cover__stamp">{{ confidential }}</div>{% endif %}
    </div>
    {% endif %}

    <div class="cover__body">
      {% if eyebrow %}<div class="cover__eyebrow">{{ eyebrow }}</div>{% endif %}
      {% if kicker %}<div class="cover__kicker">{{ kicker }}</div>{% endif %}
      <h1 class="cover__title">
        {% for line in title_lines %}<span class="cover__title-line cover__title-line--{{ loop.index }}">{{ line }}</span>{% endfor %}
      </h1>
      {% if subtitle %}<p class="cover__subtitle">{{ subtitle }}</p>{% endif %}
      {% if summary %}<p class="cover__summary">{{ summary }}</p>{% endif %}
      <div class="cover__rule"></div>
    </div>

    <div class="cover__meta">
      {% if author %}<div class="cover__meta-item cover__meta-item--author"><span class="cover__meta-label">Prepared by</span><span class="cover__meta-value">{{ author }}</span></div>{% endif %}
      {% if org and not brand_mark %}<div class="cover__meta-item cover__meta-item--org"><span class="cover__meta-label">Organisation</span><span class="cover__meta-value">{{ org }}</span></div>{% endif %}
      {% if client %}<div class="cover__meta-item cover__meta-item--client"><span class="cover__meta-label">Prepared for</span><span class="cover__meta-value">{{ client }}</span></div>{% endif %}
      {% if date %}<div class="cover__meta-item cover__meta-item--date"><span class="cover__meta-label">Date</span><span class="cover__meta-value">{{ date }}</span></div>{% endif %}
      {% if version %}<div class="cover__meta-item cover__meta-item--version"><span class="cover__meta-label">Version</span><span class="cover__meta-value">{{ version }}</span></div>{% endif %}
    </div>
  </div>

  {% if confidential and not (brand_mark or org) %}<div class="cover__stamp">{{ confidential }}</div>{% endif %}
</div>
</section>
